# Server-only runtime settings. Configure these four in Vercel too.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-6-sol-pro

# Used only by database setup/import/integration-test scripts.
DIRECT_URL=
DATABASE_URL=

# Optional browser/SSR Supabase client settings. These are public keys, never secret keys.
SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
